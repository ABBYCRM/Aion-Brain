# Optional: use NVIDIA NIM for generated teaching responses.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Optional: use an OpenAI-compatible embedding provider.
# With no key, TeacherRAG uses deterministic local hash embeddings.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

DB_PATH=.teacher_rag/teacher_rag.sqlite3
TOP_K=5
