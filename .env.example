# Load these variables into the server environment; no secrets are committed.
# Do NOT set OPENAI_API_KEY. Chat, embeddings, rerank, and images go through Bitdeer.
ENVIRONMENT=production
AION_API_KEYS=
AION_ADMIN_KEYS=
BITDEER_API_KEY=
BITDEER_API_KEYS=
BITDEER_BASE_URL=https://api-inference.bitdeer.ai/v1
BITDEER_TEXT_MODEL=mistralai/Mistral-Large-3-675B-Instruct-2512
BITDEER_IMAGE_MODEL=black-forest-labs/FLUX-2-pro
BITDEER_RERANK_MODEL=BAAI/bge-reranker-v2-m3
BITDEER_EMBED_MODEL=nvidia/Nemotron-3-Embed-1B-BF16
NVIDIA_API_KEY=
NVIDIA_API_KEYS=
NVIDIA_BASE_URL=https://api-inference.bitdeer.ai/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api-inference.bitdeer.ai/v1
EMBEDDINGS_MODEL=nvidia/Nemotron-3-Embed-1B-BF16
# Optional side-tool keys only. Do not treat these as production chat defaults.
# /v1 and /api/chat stay BITDEER-PRIMARY (nvidia catalog: PRIMARY_MODEL / AGENT_MODEL).
# lib/nvidia_only_guard.js snapshots then strips OPENAI/ANTHROPIC/A2E/XAI from process.env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
A2E_API_KEY=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GEMINI_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
YOUTUBE_API_KEY=
PRIMARY_MODEL=zai-org/GLM-5
AGENT_MODEL=mistralai/Mistral-Large-3-675B-Instruct-2512
FALLBACK_MODELS=zai-org/GLM-5,mistralai/Mistral-Large-3-675B-Instruct-2512
RERANKER_PROVIDER=bitdeer
RERANKER_MODEL=zai-org/GLM-5
HELICONE_API_KEY=
STEEL_API_KEY=
FIRECRAWL_API_KEY=
SCRAPINGBEE_API_KEY=
