NODE_ENV=development
PORT=10000

# Gateway clients authenticate with x-gateway-key. Use comma-separated values during key rotation.
LLM_GATEWAY_API_KEYS=replace-with-a-long-random-key

# Operational endpoints authenticate with x-admin-token.
LLM_GATEWAY_ADMIN_TOKEN=replace-with-a-different-long-random-token

# Comma-separated browser origins. Required in production.
LLM_GATEWAY_CORS_ORIGINS=http://localhost:3000

# Production should keep echo disabled and configure at least one provider.
LLM_GATEWAY_ALLOW_ECHO=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
A2E_API_KEY=

# Off by default. When enabled, client-supplied x-openai-key/x-anthropic-key/x-a2e-key are accepted.
LLM_GATEWAY_ALLOW_CLIENT_PROVIDER_KEYS=false

LLM_GATEWAY_DATA_DIR=./data
LLM_GATEWAY_REPORTS_DIR=./reports
LLM_GATEWAY_RATE_LIMIT_REQUESTS=120
LLM_GATEWAY_RATE_LIMIT_WINDOW_MS=60000
LLM_GATEWAY_MAX_CALL_ROWS=100000
LLM_GATEWAY_MAX_AUDIT_ROWS=1000
