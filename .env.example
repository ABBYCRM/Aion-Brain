# Load these variables into the server environment; no secrets are committed.
ENVIRONMENT=production
AION_API_KEYS=
AION_ADMIN_KEYS=

# NVIDIA NIM only for model and embedding inference.
NVIDIA_API_KEY=
NVIDIA_API_KEYS=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b
AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
FALLBACK_MODELS=moonshotai/kimi-k2.6,nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-nano-30b-a3b
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDINGS_MODEL=nvidia/nemotron-3-embed-1b

# Agent tools / observability / retrieval.
HELICONE_API_KEY=
LANGCHAIN_API_KEY=
STEEL_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
COMPOSIO_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
E2B_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
INNGEST_EVENT_KEY=
A2E_API_KEY=
HEDRA_API_KEY=
SCRAPINGBEE_API_KEY=
SCRAPFLY_API_KEY=
SCREENSHOTONE_ACCESS_KEY=
SCREENSHOTONE_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM=

# GitHub tools. Set GITHUB_TOKEN at runtime; never commit a PAT.
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_ALLOWED_REPOSITORIES=

# GDY OSINT tool directory — keys are injected as deployment secrets; never commit them.
GDY_API_BASE=https://gdy-tool-directory-a6hzh.ondigitalocean.app/v1
GDY_BASE_URL=https://gdy-tool-directory-a6hzh.ondigitalocean.app
GDY_API_KEY=
GDY_API_KEY_ALT=

N8N_MCP_URL=https://paisabrazil.app.n8n.cloud/mcp-server/http
N8N_MCP_TOKEN=
N8N_API_URL=https://paisabrazil.app.n8n.cloud/api/v1/
