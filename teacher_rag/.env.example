# NVIDIA NIM only. Do not set OPENAI_API_KEY for TeacherRAG.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional dedicated NVIDIA key for embeddings; otherwise NVIDIA_API_KEY is reused.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDINGS_MODEL=nvidia/nemotron-3-embed-1b

DB_PATH=.teacher_rag/teacher_rag.sqlite3
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=120
