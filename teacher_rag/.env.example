# Bitdeer inference. Do not set OPENAI_API_KEY for TeacherRAG.
BITDEER_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://api-inference.bitdeer.ai/v1
NVIDIA_MODEL=mistralai/Mistral-Large-3-675B-Instruct-2512

# Optional dedicated embeddings key; otherwise BITDEER_API_KEY / NVIDIA_API_KEY is reused.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api-inference.bitdeer.ai/v1
EMBEDDINGS_MODEL=nvidia/Nemotron-3-Embed-1B-BF16

DB_PATH=.teacher_rag/teacher_rag.sqlite3
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=120
