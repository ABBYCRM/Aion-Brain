CURSOR_API_BASE_URL=https://api.cursor.com
CURSOR_DEFAULT_REPO=
TEACHER_RAG_PYTHON=python3
TEACHER_RAG_TIMEOUT_MS=60000
LLM_GATEWAY_DATA_DIR=
LLM_GATEWAY_REPORTS_DIR=
AION_ECHO_ONLY=
